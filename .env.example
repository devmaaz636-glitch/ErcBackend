# Copy this file to .env and fill in the values. Never commit .env.

PORT=4000
NODE_ENV=development

# Cloud Redis connection string (Upstash / Redis Cloud). Use rediss:// for TLS.
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_HOST:6379

# Random secret used to hash reset codes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=

# Firebase Admin: Firebase console > Project settings > Service accounts > Generate new private key.
# Save the file in this folder as firebase-service-account.json (git-ignored).
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# SMTP for sending codes. Leave SMTP_HOST empty in development to print codes in this console.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
#        SMTP_USER=your Gmail address, SMTP_PASS=a Gmail App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Enfield Royal Clinics <no-reply@enfieldroyal.com>"

# Optional tuning (defaults shown)
# RESET_CODE_LENGTH=6
# RESET_CODE_TTL_SECONDS=600
# RESET_RESEND_COOLDOWN_SECONDS=60
# RESET_MAX_SENDS_PER_HOUR=5
# RESET_MAX_VERIFY_ATTEMPTS=5
# RESET_TOKEN_TTL_SECONDS=900
# Set to 1 when running behind one reverse proxy / load balancer.
# TRUST_PROXY=0
# Comma-separated browser origins. Keep * only for local development.
# CORS_ORIGINS=http://localhost:8081,http://localhost:19006
